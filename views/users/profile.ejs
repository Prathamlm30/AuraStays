<% layout("/layouts/boilerPlate") %>

<div class="row mt-5 justify-content-center mb-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 card-rounded">
            <div class="card-body p-5 text-center">
                
                <div class="mb-4 mx-auto profile-avatar-lg">
                    <%= currUser.username.charAt(0).toUpperCase() %>
                </div>
                
                <h2 class="fw-bold text-capitalize mb-1"><%= currUser.username %></h2>
                <p class="text-muted mb-4"><i class="fa-regular fa-envelope me-2"></i> <%= currUser.email %></p>

                <hr class="mb-4">

                <div class="row text-center mb-4">
                    <div class="col-6 border-end">
                        <h4 class="fw-bold"><%= currUser.wishlists ? currUser.wishlists.length : 0 %></h4>
                        <span class="text-muted">Saved Places</span>
                    </div>
                    <div class="col-6">
                        <h4 class="fw-bold">0</h4>
                        <span class="text-muted">Trips Booked</span>
                    </div>
                </div>

                <a href="/listings" class="btn btn-brand w-100 py-3 fw-bold">
                    Continue Exploring
                </a>
                
            </div>
        </div>
    </div>
</div>