<% layout("/layouts/boilerPlate") %>

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="card p-5 border shadow-sm" style="border-radius: 1rem; width: 100%; max-width: 600px; border-color: #f0f0f0;">
        
        <div class="text-center mb-3">
            <div class="rounded-circle text-white d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 90px; height: 90px; background-color: #fe424d; font-size: 2.5rem; font-weight: bold;">
                <%= currUser.username.charAt(0).toUpperCase() %>
            </div>
        </div>

        <div class="text-center mb-4">
            <h3 class="fw-bold mb-1"><%= currUser.username %></h3>
            <p class="text-muted mb-0"><i class="fa-regular fa-envelope me-2"></i><%= currUser.email %></p>
        </div>

        <hr style="border-color: #dddddd;">

        <div class="row text-center my-4">
            <div class="col-4 border-end" style="border-color: #dddddd !important;">
                <h4 class="fw-bold mb-1">
                    <%= currUser.wishlists ? currUser.wishlists.length : 0 %>
                </h4>
                <span class="text-muted" style="font-size: 0.95rem;">Saved</span>
            </div>
            
            <div class="col-4 border-end" style="border-color: #dddddd !important;">
                <h4 class="fw-bold mb-1"><%= tripCount %></h4>
                <span class="text-muted" style="font-size: 0.95rem;">Trips</span>
            </div>

            <div class="col-4">
                <h4 class="fw-bold mb-1" style="color: #198754;">
                    &#8377;<%= typeof totalEarnings !== 'undefined' ? totalEarnings.toLocaleString("en-IN") : 0 %>
                </h4>
                <span class="text-muted" style="font-size: 0.95rem;">Earned</span>
            </div>
        </div>

        <div class="text-center mt-3 mb-3">
            <a href="/payout" class="btn text-white fw-bold shadow-sm w-100 py-2" style="background-color: #fe424d; border-radius: 0.5rem; font-size: 1.05rem;">
                <i class="fa-solid fa-wallet me-2"></i> Manage Payout Settings
            </a>
        </div>

        <div class="text-center mt-2">
            <a href="/listings" class="text-dark fw-bold text-decoration-none hover-red" style="font-size: 0.95rem;">Continue Exploring</a>
        </div>

    </div>
</div>