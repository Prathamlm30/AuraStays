<% layout("/layouts/boilerPlate") %>

<div class="row mt-4 mb-3">
    <div class="col-12">
        <h2 class="fw-bold"><i class="fa-solid fa-heart text-danger me-2"></i> Your Wishlists</h2>
        <p class="text-muted">Places you've saved for your next adventure.</p>
    </div>
</div>

<% if(!allListings || allListings.length === 0) { %>
    <div class="alert alert-light border text-center p-5 mt-4 card-rounded">
        <i class="fa-regular fa-folder-open fs-1 text-muted mb-3"></i>
        <h4>No saved listings yet</h4>
        <p class="text-muted mb-4">As you search, click the heart icon to save your favorite places.</p>
        <a href="/listings" class="btn btn-dark btn-pill-sm">Start Exploring</a>
    </div>
<% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings) { %>
            <div class="col mb-4">
                <div class="card listing-card h-100 border-0 position-relative bg-transparent">
                    
                    <% if(currUser) { %>
                        <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="position-absolute top-0 end-0 p-3" style="z-index: 10;">
                            <button type="submit" class="card-heart-btn" aria-label="Remove from Wishlist">
                                <i class="fa-solid fa-heart text-danger"></i>
                            </button>
                        </form>
                    <% } %>

                    <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark d-block">
                        <img src="<%= listing.image.url %>" class="card-img-top rounded-4 shadow-sm" alt="listing_image" style="height: 20rem; object-fit: cover;">
                        <div class="card-body px-1 py-3">
                            <p class="card-text mb-0">
                                <b class="fs-5"><%= listing.title %></b> <br>
                                <span class="fw-semibold mt-1 d-inline-block">&#8377; <%= listing.price.toLocaleString("en-IN") %></span> / night
                            </p>
                        </div>
                    </a>
                    
                </div>
            </div>
        <% } %>
    </div>
<% } %>