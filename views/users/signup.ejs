<% layout("/layouts/boilerPlate") %>

<div class="row mt-5 justify-content-center mb-5">
    <div class="col-11 col-md-8 col-lg-5">
        <div class="card shadow-lg border-0" style="border-radius: 1.5rem;">
            <div class="card-body p-5">
                
                <div class="text-center mb-4 mt-3">
                    <!-- Prominent Brand Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#fe424d" stroke-linecap="round" stroke-linejoin="round" class="mb-2">
                        <path d="M3 10L12 3L21 10" stroke-width="2.5" />
                        <path d="M7 11V20C7 20.5523 7.44772 21 8 21H16C16.5523 21 17 20.5523 17 20V11" stroke-width="2.5" />
                        <path d="M19 2 L19.5 3.5 L21 4 L19.5 4.5 L19 6 L18.5 4.5 L17 4 L18.5 3.5 Z" fill="#fe424d" stroke="none" />
                    </svg>
                    <h2 class="fw-bolder" style="color: #222; letter-spacing: -0.5px;">Join AuraStays</h2>
                    <p class="text-muted" style="font-size: 0.9rem;">Create an account to explore premium stays around the globe.</p>
                </div>

                <form action="/signup" method="POST" class="needs-validation" novalidate>
                    <!-- Floating Label for Username -->
                    <div class="form-floating mb-3">
                        <input name="username" id="username" type="text" class="form-control" placeholder="Username" style="border-radius: 0.75rem;" required>
                        <label for="username">Username</label>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <!-- Floating Label for Email -->
                    <div class="form-floating mb-3">
                        <input name="email" id="email" type="email" class="form-control" placeholder="Email" style="border-radius: 0.75rem;" required>
                        <label for="email">Email address</label>
                    </div>
                    
                    <!-- Floating Label for Password -->
                    <div class="form-floating mb-4">
                        <input name="password" id="password" type="password" class="form-control" placeholder="Password" style="border-radius: 0.75rem;" required>
                        <label for="password">Password</label>
                    </div>
                    
                    <button class="btn w-100 py-3 text-white fw-bold mb-3" style="background-color: #fe424d; border-radius: 0.75rem; font-size: 1.1rem; border: none;">
                        Sign Up
                    </button>
                </form>

                <!-- Preparation for OAuth -->
                <div class="d-flex align-items-center my-4">
                    <hr class="flex-grow-1">
                    <span class="mx-3 text-muted" style="font-size: 0.9rem;">or</span>
                    <hr class="flex-grow-1">
                </div>

                <a href="/auth/google" class="btn btn-outline-dark w-100 py-2 fw-semibold d-flex justify-content-center align-items-center gap-2 mb-4" style="border-radius: 0.75rem;">
                    <i class="fa-brands fa-google text-danger"></i> Continue with Google
                </a>

                <div class="text-center">
                    <p class="text-muted mb-0">Already have an account? 
                        <a href="/login" style="color: #fe424d; text-decoration: none; font-weight: 600;">Log in</a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>