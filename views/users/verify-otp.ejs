<% layout("/layouts/boilerPlate") %>

<div class="row mt-5 justify-content-center mb-5">
    <div class="col-11 col-md-8 col-lg-5">
        <div class="card shadow-lg border-0" style="border-radius: 1.5rem;">
            <div class="card-body p-5">
                
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="fa-solid fa-envelope-open-text" style="color: #fe424d; font-size: 3rem;"></i>
                    </div>
                    <h3 class="fw-bold">Check your email</h3>
                    <p class="text-muted">We sent a 6-digit verification code to your email address.</p>
                </div>

                <form action="<%= actionUrl %>" method="POST" class="needs-validation" novalidate>
                    <div class="form-floating mb-4">
                        <input name="otp" id="otp" type="text" class="form-control text-center fw-bold fs-4" placeholder="123456" maxlength="6" style="border-radius: 0.75rem; letter-spacing: 0.5rem;" required>
                        <label for="otp">6-Digit Code</label>
                    </div>
                    
                    <button class="btn w-100 py-3 text-white fw-bold mb-3" style="background-color: #fe424d; border-radius: 0.75rem; font-size: 1.1rem; border: none;">
                        <%= buttonText || 'Verify Identity' %>
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>