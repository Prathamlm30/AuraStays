<% layout("/layouts/boilerPlate") %>

<div class="row mt-4">
    <div class="col-10 offset-1">
        
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold mb-0"><%= listing.title %></h2>
            
            <% if(currUser) { %>
                <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="m-0">
                    <% 
                       // Bulletproof MongoDB ObjectId check
                       let isSaved = currUser.wishlists && currUser.wishlists.some(id => id.equals(listing._id)); 
                    %>
                    <button type="submit" class="btn btn-light border-0 rounded-circle shadow-sm heart-btn" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                        <% if(isSaved) { %>
                            <i class="fa-solid fa-heart text-danger fs-4"></i>
                        <% } else { %>
                            <i class="fa-regular fa-heart text-muted fs-4"></i>
                        <% } %>
                    </button>
                </form>
            <% } %>
        </div>

        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 50vh; width: 100%; object-fit: cover; border-radius: 1.5rem;">
    </div>
</div>

<div class="row mt-4 mb-5">
    
    <div class="col-6 offset-1">
        
        <div class="mb-4">
            <h4 class="fw-bold">Entire place hosted by <%= listing.owner.username %></h4>
            <p class="text-muted"><%= listing.location %>, <%= listing.country %></p>
            <hr>
            <p class="card-text" style="line-height: 1.6; font-size: 1.05rem;"><%= listing.description %></p>
        </div>

        <div id="ai-container" class="ai-summary-container p-4 mb-4" data-id="<%= listing._id %>">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-wand-magic-sparkles ai-icon"></i> AI Listing Insights</h5>
                <button id="ai-btn" class="btn btn-sm ai-btn">Generate Insights</button>
            </div>
            
            <div id="ai-output" class="mt-3 ai-output-area">
                <div class="text-center ai-loader" id="ai-loader">
                    <div class="spinner-border spinner-border-sm ai-icon" role="status"></div>
                    <span class="ms-2">Analyzing property, location, and reviews...</span>
                </div>
                <div id="ai-text"></div>
            </div>
        </div>

        <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
            <div class="d-flex gap-3 mb-4">
                <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark px-4 edit-btn">Edit Listing</a>
                <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="m-0">
                    <button class="btn btn-dark px-4">Delete Listing</button>
                </form>
            </div>
        <% } %>

        <hr>

        <div class="mb-4 mt-4">
            <% if(currUser) { %>
                <h4 class="fw-bold mb-3">Leave a Review</h4>
                <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation mb-4">
                    <div class="mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comments</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
                        <div class="invalid-feedback">Please add some comments for review</div>
                    </div>
                    <button class="btn btn-outline-dark">Submit Review</button>
                </form>
                <hr>
            <% } %>

            <% if(listing.reviews.length > 0) { %>
                <h4 class="fw-bold mb-4">Guest Reviews</h4>
                <div class="row">
                    <% for(review of listing.reviews) { %>
                        <div class="card col-12 mb-4 shadow-sm" style="border-radius: 1rem; border: 1px solid #e9ecef;">
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@<%= review.author.username %></h5>
                                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                                <p class="card-text"><%= review.comment %></p>    
                                
                                <% if(review.hostReply) { %>
                                    <div class="mt-3 p-3 rounded host-reply-box">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <p class="mb-1 host-reply-header">
                                                <i class="fa-solid fa-reply ai-icon"></i> Host Reply:
                                            </p>
                                            <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                                                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>/reply?_method=DELETE" class="m-0 p-0">
                                                    <button type="submit" class="btn btn-sm text-danger p-0 host-reply-delete-btn" title="Delete Reply">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                        <p class="mb-0 mt-1 host-reply-body"><%= review.hostReply %></p>
                                    </div>
                                <% } %>
                                
                                <% if(currUser && currUser._id.equals(listing.owner._id) && !review.hostReply) { %>
                                    <hr>
                                    <button class="btn btn-sm btn-outline-danger ai-reply-btn mb-2" data-review-id="<%= review._id %>">
                                        <i class="fa-solid fa-robot"></i> Draft AI Reply
                                    </button>
                                    
                                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>/reply" method="POST" class="ai-reply-box" id="reply-box-<%= review._id %>" style="display: none;">
                                        <div class="spinner-border spinner-border-sm text-danger mb-2" id="loader-<%= review._id %>" style="display: none;" role="status"></div>
                                        <textarea name="hostReply" class="form-control ai-reply-textarea mb-2" id="reply-text-<%= review._id %>" rows="3" required></textarea>
                                        <button type="submit" class="btn btn-sm btn-dark mb-2">Post Reply</button>
                                    </form>
                                <% } %>
                            </div>
                            
                            <% if(currUser && currUser._id.equals(review.author._id)) { %>
                                <div class="card-footer bg-transparent border-0 pt-0">
                                    <form method="POST" action="/listings/<%=listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-dark">Delete My Review</button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>

        <hr>

        <div class="mb-4 mt-4">
            <h4 class="fw-bold mb-3">Where you'll be</h4>
            <div id="map" style="height: 400px; width: 100%; border-radius: 1.5rem; z-index: 1;"></div>
        </div>

    </div>

    <!-- RIGHT SIDEBAR: PRICING & RESERVATION -->
    <div class="col-4">
        <div class="card p-4 shadow" style="border-radius: 1.5rem; border: 1px solid #e3e3e3; position: sticky; top: 120px;">
            
            <h3 class="fw-bold mb-4">
                &#8377; <%= listing.price.toLocaleString("en-IN") %> 
                <span class="fs-5 text-muted fw-normal">night</span>
            </h3>

            <div class="ai-planner-container p-3 rounded mb-4 border">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa-solid fa-map-location-dot ai-icon"></i> AI Trip Planner
                    </h6>
                    <button id="itinerary-btn" class="btn btn-sm ai-btn" style="font-size: 0.8rem;">Plan Trip</button>
                </div>
                
                <div id="itinerary-output" class="mt-3" style="display: none;">
                    <div class="text-center mb-3" id="itinerary-loader">
                        <div class="spinner-border spinner-border-sm ai-icon" role="status"></div>
                        <span class="ms-2 ai-planner-loader-text" style="font-size: 0.85rem;">Crafting itinerary...</span>
                    </div>
                    <div id="itinerary-text" class="text-dark" style="font-size: 0.9rem; max-height: 400px; overflow-y: auto;"></div>
                </div>
            </div>

            <!-- NEW DYNAMIC CALENDAR BOOKING FORM -->
            <form action="/listings/<%= listing._id %>/bookings" method="POST" id="bookingForm">
                
                <div class="row g-0 border rounded-3 mb-3 mt-3 text-start bg-white" style="font-size: 0.85rem; border-color: #dddddd !important; cursor: pointer;" id="datePickerContainer">
                    <div class="col-6 border-end p-2 px-3 position-relative" style="border-color: #dddddd !important;">
                        <label class="fw-bold text-muted text-uppercase mb-0 d-block" style="font-size: 0.65rem;">Check-In</label>
                        <input type="text" id="checkIn" name="checkIn" placeholder="Add date" class="form-control border-0 p-0 fw-semibold bg-transparent shadow-none" style="font-size: 0.9rem;" required readonly>
                    </div>
                    <div class="col-6 p-2 px-3 position-relative">
                        <label class="fw-bold text-muted text-uppercase mb-0 d-block" style="font-size: 0.65rem;">Checkout</label>
                        <input type="text" id="checkOut" name="checkOut" placeholder="Add date" class="form-control border-0 p-0 fw-semibold bg-transparent shadow-none" style="font-size: 0.9rem;" required readonly>
                    </div>
                </div>
                
                <button type="submit" class="btn w-100 py-3 fw-bold text-white search-btn shadow-sm rounded-3 mb-2" style="background-color: #fe424d; font-size: 1.05rem;">Reserve</button>
                <p class="text-center text-muted m-0" style="font-size: 0.85rem;">You won't be charged yet</p>
            </form>
            <!-- END NEW FORM -->

        </div>
    </div>

</div>

<!-- EXTERNAL SCRIPTS -->
<script>
    const listingData = <%- JSON.stringify(listing) %>;
</script>
<script src="/js/map.js?v=2"></script>
<script src="/js/ai.js"></script>

<!-- FLATPICKR CDN LINKS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<!-- OUR CUSTOM EXTERNAL FILES -->
<link rel="stylesheet" href="/css/calendar.css">
<script src="/js/calendar.js"></script>