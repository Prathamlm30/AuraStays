<style>
  /* Existing Search Bar Styles */
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }
  .search-btn:hover {
    background-color: #e03540;
    color: #fff;
  }
  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }
  .search-inp {
    width: 24rem;
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }

  /* NEW: Modern Profile Pill Styles */
  .profile-pill {
    border: 1px solid #dddddd;
    border-radius: 30px;
    padding: 5px 12px 5px 5px !important;
    transition: box-shadow 0.2s ease, transform 0.1s ease;
    background-color: #ffffff;
    cursor: pointer;
  }
  .profile-pill:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .profile-pill:active {
    transform: scale(0.97);
  }
  
  .user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #fe424d;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1rem;
  }

  /* NEW: Dropdown Menu Aesthetics */
  .profile-dropdown {
    border-radius: 1rem;
    min-width: 240px;
    border: 1px solid #ebebeb;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    padding: 0.5rem 0;
    margin-top: 10px !important;
  }
  .profile-dropdown .dropdown-item {
    padding: 0.7rem 1.5rem;
    font-weight: 500;
    color: #444;
    transition: background-color 0.2s;
  }
  .profile-dropdown .dropdown-item:hover {
    background-color: #f8f9fa;
    color: #222;
  }
  .profile-dropdown .dropdown-divider {
    border-color: #ebebeb;
  }

/* OPTION 2: Liquid Titanium */
.brand-titanium {
    background: linear-gradient(
        90deg,
        #fe424d 0%,
        #fe424d 35%,
        #ffffff 50%,
        #fe424d 65%,
        #fe424d 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent !important;
    animation: titaniumShine 2.5s infinite linear;
}

@keyframes titaniumShine {
    0% { background-position: -100% center; }
    100% { background-position: 100% center; }
}

.aura-sparkle {
    animation: starPulse 2s infinite alternate ease-in-out;
    transform-origin: 19px 5px;
}

@keyframes starPulse {
    0% { transform: scale(0.8); opacity: 0.6; }
    100% { transform: scale(1.2); opacity: 1; }
}

/* Optional: Slight hover lift for the whole brand section */
.navbar-brand {
    transition: transform 0.3s ease;
}
.navbar-brand:hover {
    transform: translateY(-1px);
}
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center" href="/listings">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="#fe424d" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 10L12 3L21 10" stroke-width="2.5" />
            <path d="M7 11V20C7 20.5523 7.44772 21 8 21H16C16.5523 21 17 20.5523 17 20V11" stroke-width="2.5" />
            <path class="aura-sparkle" d="M19 2 L19.5 3.5 L21 4 L19.5 4.5 L19 6 L18.5 4.5 L17 4 L18.5 3.5 Z" fill="#fe424d" stroke="none" />
        </svg>
        <span class="fw-bolder ms-2 brand-titanium" style="font-size: 1.5rem; letter-spacing: -0.8px;">AuraStays</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

    <% if (!locals.currentPath || (locals.currentPath !== '/login' && locals.currentPath !== '/signup')) { %>
      <div class="navbar-nav ms-auto">
        <form class="d-flex align-items-center" role="search" action="/listings/search" method="GET">
          <input 
              class="form-control me-2 search-inp" 
              type="search" 
              placeholder="Search destinations or vibes..." 
              name="q" 
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          >
          <button class="btn search-btn" type="submit">
              <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
      </form>
      </div>
    <% } %>

      <div class="navbar-nav ms-auto align-items-center">
        <a class="nav-link me-3 fw-semibold" style="color: #222;" href="/listings/new">Become a Host</a>
        
        <% if(!locals.currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
        <% } %>
        
        <% if(locals.currUser) { %>
          <div class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 profile-pill" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-bars text-muted ms-2 fs-6"></i>
                <div class="user-avatar">
                    <%= locals.currUser.username.charAt(0).toUpperCase() %>
                </div>
            </a>
            
            <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
                <li class="px-4 py-3 border-bottom mb-2">
                    <div class="fw-bold fs-6 text-dark" style="text-transform: capitalize;"><%= locals.currUser.username %></div>
                    <div class="text-muted" style="font-size: 0.85rem;"><%= locals.currUser.email %></div>
                </li>

                <!-- Admin-Only Command Center Link -->
                <% if (locals.currUser && locals.currUser.role === 'admin') { %>
                    <a class="dropdown-item fw-bold text-danger" href="/admin/dashboard">
                        <i class="fa-solid fa-shield-halved me-2"></i> Command Center
                    </a>
                    <li><hr class="dropdown-divider"></li>
                <% } %>
                
                <li>
                  <a class="dropdown-item" href="/profile">
                    <i class="fa-regular fa-user me-2 text-muted"></i> My Profile
                  </a>
                </li>
                <li>
                  <a class="dropdown-item" href="/trips">
                    <i class="fa-solid fa-suitcase-rolling me-2 text-muted"></i> My Trips
                  </a>
                </li>
                <li>
                  <a class="dropdown-item" href="/wishlists">
                    <i class="fa-regular fa-heart me-2 text-muted"></i> Wishlists
                  </a>
                </li>
                
                <li><hr class="dropdown-divider my-2"></li>
                
                <li>
                  <a class="dropdown-item fw-bold" href="/logout" style="color: #fe424d;">
                    <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Log out
                  </a>
                </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>